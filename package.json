{
  "name": "netpocket-cybersecurity",
  "private": true,
  "version": "1.0.0",
  "description": "NetPocket Cybersecurity — 100% offline tactical toolkit for SOC analysts, network engineers and sysadmins.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test:crypto": "node --experimental-strip-types scripts/verify-utils.ts",
    "cap:add:android": "npx cap add android && node scripts/harden-android.mjs",
    "cap:sync": "npm run build && npx cap sync android && node scripts/harden-android.mjs",
    "android:harden": "node scripts/harden-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
